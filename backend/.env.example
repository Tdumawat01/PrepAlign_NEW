# Copy to backend/.env and fill in values. Never commit .env.

# --- Required: MongoDB ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=prepalign

# --- Required for AI (company insights + Career GPS roadmaps) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override default roadmap model
OPENROUTER_ROADMAP_MODEL=openai/gpt-4o-mini
# Optional: override default insights model
OPENROUTER_INSIGHTS_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Required for Jobs (Google Jobs via SerpAPI) ---
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- Auth / admin ---
# Comma-separated emails allowed to access admin APIs
ADMIN_EMAILS=

# --- CORS (comma-separated origins; use * only for local/dev) ---
CORS_ORIGINS=http://localhost:3000
